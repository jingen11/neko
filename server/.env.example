NEKO_HOST=127.0.0.1
NEKO_PORT=8081
LLAMA_URL=http://127.0.0.1:8080
STT_URL=ws://127.0.0.1:6006
VOICEVOX_URL=http://127.0.0.1:50021
# VOICEVOX speaker (style) id for the pet's voice — see GET /api/voices
VOICEVOX_SPEAKER=3
# JLPT level the pet talks at: N5..N1
NEKO_LEVEL=N4
# The pet's name (Japanese is fine)
NEKO_PET_NAME=ねこ
# Your time zone (IANA name) — decides bedtime and what "today" means for the streak
# NEKO_TZ=Asia/Kuala_Lumpur   (IANA name; defaults to the box time zone)
# Learning records for Obsidian/Hermes (empty = off)
# NEKO_VAULT_DIR=~/vault/Japanese   (default; set it empty to turn records off)
# Hermes API server for grammar questions; HERMES_KEY = API_SERVER_KEY in ~/.hermes/.env.
# Without a key, questions are answered by llama.cpp directly.
HERMES_URL=http://127.0.0.1:8642
# HERMES_KEY=
