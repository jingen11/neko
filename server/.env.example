NEKO_HOST=127.0.0.1
NEKO_PORT=8081
LLAMA_URL=http://127.0.0.1:8080
STT_URL=ws://127.0.0.1:6006
VOICEVOX_URL=http://127.0.0.1:50021
# VOICEVOX speaker (style) id for the pet's voice — see GET /api/voices
VOICEVOX_SPEAKER=3
# JLPT level the pet talks at: N5..N1
NEKO_LEVEL=N4
# The pet's name (Japanese is fine)
NEKO_PET_NAME=ねこ
# Your time zone (IANA name) — decides bedtime and what "today" means for the streak
# NEKO_TZ=Asia/Kuala_Lumpur   (IANA name; defaults to the box time zone)
# Learning records for Obsidian/Hermes (empty = off)
# NEKO_VAULT_DIR=~/vault/Japanese   (default; set it empty to turn records off)
# Hermes API server: every Ask box question goes through it (no fallback).
HERMES_URL=http://127.0.0.1:8642
# Casual questions -> Hermes default profile; key = API_SERVER_KEY in ~/.hermes/.env
# HERMES_KEY=
# Grammar questions -> Hermes profile served at /p/<profile>/; key = API_SERVER_KEY in
# ~/.hermes/profiles/<profile>/.env
HERMES_PRO_PROFILE=pro
# HERMES_PRO_KEY=
# ねこ's spoken replies -> Hermes profile with tools (time, weather); key = API_SERVER_KEY in
# ~/.hermes/profiles/<profile>/.env
HERMES_NEKO_PROFILE=neko
# HERMES_NEKO_KEY=
# Model names shown on answer cards (display only; match each profile's config)
HERMES_MODEL_LABEL=Qwen3.6
HERMES_PRO_MODEL_LABEL=Claude Opus 5.5
# MQTT broker Zigbee2MQTT talks through (empty = off)
# MQTT_URL=mqtt://127.0.0.1:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_BASE_TOPIC=zigbee2mqtt
# Zigbee2MQTT device names of the sensors neko listens to (front_door_open, front_window_1_vibrate)
# NEKO_DOOR_SENSOR=front_door
# NEKO_WINDOW_SENSOR=front_window_1
