[Unit]
Description=Home sensor dashboard (dash.home.je-dev.com)
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
User=jedev
Environment=HOME=/home/jedev
WorkingDirectory=/home/jedev/projects/neko/home
ExecStart=/usr/local/bin/node --env-file-if-exists=.env src/index.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
